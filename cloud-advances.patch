new file mode 100644
index 0000000..768aa52
--- /dev/null
+++ b/tests/advances.test.mjs
@@ -0,0 +1,59 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {runInNewContext} from 'node:vm';
+import {validateTripDocument} from '../lib/journal-collaboration.mjs';
+const html=await readFile(new URL('../public/trip.html',import.meta.url),'utf8'),ctx={};
+const block=n=>html.split('// BEGIN_'+n)[1].split('// END_'+n)[0];
+runInNewContext(block('MONEY_ROUTE_HELPERS')+block('FINANCE_HELPERS')+';this.h={spendingSummary,cashBalance,advanceStatus,advanceError};',ctx);
+const h=ctx.h,plain=v=>JSON.parse(JSON.stringify(v));
+const expense={id:'ride',label:'Synthetic ride',kind:'expense',cur:'PHP',amt:900,ownAmt:300,pay:'刷卡',actualTwd:480};
+const receipt={id:'paid',label:'Synthetic receipt',kind:'reimbursement',expenseId:'ride',cur:'PHP',amt:600,pay:'現金'};
+const snap={amount:2000,includedIds:[]};
+test('personal cost uses own share, full card amount survives and repayment is never income or spending',()=>{
+ const rows=[expense,receipt],v=h.spendingSummary(rows,{PHP:0.5});
+ assert.equal(v.totals.PHP,300);assert.equal(v.twd,160);assert.equal(expense.amt,900);assert.equal(expense.actualTwd,480);
+ assert.equal(h.cashBalance(snap,rows,'PHP').amount,2600);assert.deepEqual(plain(h.advanceStatus(expense,rows)),{total:600,received:600,outstanding:0,excess:0,invalid:0});
+});
+test('cash advance deducts full payment and returned cash increases it without double counting',()=>{
+ assert.equal(h.cashBalance(snap,[{...expense,pay:'現金'},receipt],'PHP').amount,1700);
+ assert.equal(h.cashBalance(snap,[expense,{...receipt,pay:'轉帳'}],'PHP').amount,2000);
+ assert.equal(h.cashBalance(snap,[expense,{...receipt,cashIncluded:true}],'PHP').amount,2000);
+ assert.equal(h.cashBalance({amount:2600,includedIds:['ride','paid']},[expense,receipt],'PHP').amount,2600);
+});
+test('uncollected and partial repayments affect receivables, never personal spending',()=>{
+ const partial={...receipt,amt:200};assert.equal(h.advanceStatus(expense,[]).outstanding,600);
+ assert.equal(h.advanceStatus(expense,[partial]).outstanding,400);assert.equal(h.spendingSummary([expense,partial],{}).totals.PHP,300);
+ assert.equal(h.advanceStatus(expense,[]).received,0);
+});
+test('legacy, zero own share and invalid share are explicit without changing old expenses',()=>{
+ assert.equal(h.spendingSummary([{amt:100,cur:'PHP'}],{PHP:0.5}).twd,50);
+ assert.equal(h.spendingSummary([{...expense,ownAmt:0}],{}).twd,0);
+ assert.deepEqual(plain(h.spendingSummary([{...expense,ownAmt:901}],{})),{totals:{},twd:0,missing:[],pending:1});
+ assert.equal(h.advanceError({id:'empty',kind:'expense',amt:null,cur:'PHP'},[]),'');
+});
+test('form checks prevent overcollection, wrong currency and destroying paid links',()=>{
+ assert.equal(h.advanceError(receipt,[expense]),'');
+ assert.ok(h.advanceError({...receipt,amt:601},[expense]));
+ assert.ok(h.advanceError({...receipt,cur:'USD'},[expense]));
+ assert.ok(h.advanceError({...receipt,expenseId:'missing'},[expense]));
+ assert.ok(h.advanceError({...expense,ownAmt:400},[expense,receipt]));
+ assert.ok(h.advanceError({...expense,cur:'USD'},[expense,receipt]));
+ assert.ok(h.advanceError({...expense,kind:'cashflow'},[expense,receipt]));
+});
+test('concurrent overcollection and orphan receipts remain visible and keep actual cash',()=>{
+ const rows=[expense,receipt,{...receipt,id:'concurrent',amt:100}];assert.equal(h.advanceStatus(expense,rows).excess,100);
+ assert.equal(h.cashBalance(snap,rows,'PHP').amount,2700);
+ assert.equal(h.cashBalance(snap,[receipt],'PHP').amount,2600);
+ const v=h.advanceStatus(expense,[{...receipt,cur:'USD'}]);assert.equal(v.invalid,1);assert.equal(v.received,0);
+});
+test('backup roundtrip retains links, gross payment, own share and resulting money',()=>{
+ const before={moneyVersion:3,data:{misc:[expense,receipt]},private:{wallet:{snapshots:{PHP:snap}}}},after=JSON.parse(JSON.stringify(before));
+ assert.deepEqual(after,before);assert.equal(h.cashBalance(after.private.wallet.snapshots.PHP,after.data.misc,'PHP').amount,2600);
+ assert.equal(h.spendingSummary(after.data.misc,{}).totals.PHP,300);
+ assert.ok(html.includes('p.moneyVersion > 3'));
+});
+test('GPT validation accepts advances and rejects impossible own amounts or missing receipt links',()=>{
+ validateTripDocument('misc/ride',expense);validateTripDocument('misc/paid',receipt);
+ for(const v of [{...expense,ownAmt:1000},{...expense,ownAmt:-1},{...expense,cur:'VND',ownAmt:0.5},{...receipt,expenseId:''},{...receipt,pay:'刷卡'},{...receipt,amt:0}])assert.throws(()=>validateTripDocument('misc/test',v));
+});
