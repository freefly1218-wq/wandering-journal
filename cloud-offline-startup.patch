+  })());
+});
+self.addEventListener('fetch',event=>{
+  const url=new URL(event.request.url);
+  if(event.request.method!=='GET'||url.origin!==location.origin)return;
+  const path=JOURNAL_ROUTES.has(url.pathname)?'/trip':url.pathname;
