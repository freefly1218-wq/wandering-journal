+export function trustedIdentity(storage){
+  try{const value=JSON.parse(storage.getItem('journal-offline-user'));return value&&typeof value.userId==='string'&&value.userId.length?value:null;}catch{return null;}
+}
+export async function startupIdentity(storage,loadSession){
+  // This selects an existing local database only; every cloud API still verifies the live session.
+  const cached=trustedIdentity(storage);return cached?{identity:cached,fromCache:true}:{identity:await loadSession(),fromCache:false};
+}
+export function withDeadline(promise,ms,message){
+  let timer;return Promise.race([promise,new Promise((_,reject)=>{timer=setTimeout(()=>reject(new Error(message)),ms);})]).finally(()=>clearTimeout(timer));
+}
+export async function fetchBounded(input,init={},fetcher=fetch,ms=8000){
+  const controller=new AbortController(),abort=()=>controller.abort(init.signal?.reason);
+  if(init.signal?.aborted)abort();else init.signal?.addEventListener('abort',abort,{once:true});
+  let timer;
+  try{return await Promise.race([fetcher(input,{...init,signal:controller.signal}),new Promise((_,reject)=>{timer=setTimeout(()=>{controller.abort();reject(new Error('連線逾時，已保留裝置上的資料，稍後可重新同步。'));},ms);})]);}
+  finally{clearTimeout(timer);init.signal?.removeEventListener('abort',abort);}
+}
+async function workerStatus(worker,ms){
+  const channel=new MessageChannel();
+  try{return await withDeadline(new Promise((resolve,reject)=>{
+    channel.port1.onmessage=event=>resolve(event.data);
+    channel.port1.onmessageerror=()=>reject(new Error('無法檢查離線畫面，請重試。'));
+    worker.postMessage({type:'JOURNAL_OFFLINE_STATUS'},[channel.port2]);
+  }),ms,'離線程式需要更新，請保持連網並重新開啟一次。');}finally{channel.port1.close();}
+}
+export async function registerOfflineShell(nav=navigator){
+  if(!nav.serviceWorker)throw new Error('這個瀏覽器無法準備離線畫面，請使用 Safari 或 Chrome 的一般模式。');
+  const existing=await nav.serviceWorker.getRegistration?.('/');
+  if(existing?.active){
+    const saved=await workerStatus(existing.active,800).catch(()=>null);
+    if(saved?.coreReady){
+      // Checking for updates must not delay an already prepared offline launch.
+      nav.serviceWorker.register('/sw.js',{scope:'/',updateViaCache:'none'}).then(reg=>reg.update?.()).catch(()=>{});
+      return saved;
+    }
+  }
+  const registration=await withDeadline(nav.serviceWorker.register('/sw.js',{scope:'/',updateViaCache:'none'}),15000,'下載離線程式逾時，請保持連網後重試。');
+  if(registration.update)await withDeadline(registration.update(),15000,'更新離線程式逾時，請保持連網後重試。');
+  const worker=registration.installing||registration.waiting;
+  if(worker&&worker.state!=='activated')await withDeadline(new Promise((resolve,reject)=>{
+    const check=()=>{if(worker.state==='activated'){worker.removeEventListener('statechange',check);resolve();}else if(worker.state==='redundant'){worker.removeEventListener('statechange',check);reject(new Error('離線程式下載失敗，請連網後重試。'));}};
+    worker.addEventListener('statechange',check);check();
+  }),20000,'離線畫面尚未下載完成，請保持連網後重試。');
+  const ready=await withDeadline(nav.serviceWorker.ready,20000,'離線畫面尚未下載完成，請保持連網後重試。');
+  const result=await workerStatus(ready.active,5000);
+  if(!result?.coreReady)throw new Error('離線畫面不完整，請連網後重試。');
+  return result;
+}
