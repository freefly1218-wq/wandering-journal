+const VERSION='journal-sites-shell-v6';
+const CORE=['/trip','/cloud.js','/sync-core.js','/offline-core.js'];
+const OPTIONAL=['/manifest.webmanifest','/icon-192.png','/icon-512.png','/vendor/leaflet.js','/vendor/html2canvas.min.js','/vendor/jspdf.umd.min.js'];
