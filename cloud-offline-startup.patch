+const origin='https://journal.test',core=['/trip','/cloud.js','/sync-core.js','/offline-core.js'];
+function harness({fail=[],login=false}={}){
+ const handlers={},stores=new Map(),calls=[];let skipped=0,claimed=0;
+ const cache=name=>{if(!stores.has(name))stores.set(name,new Map());const m=stores.get(name);return {match:async p=>m.get(p)?.clone(),put:async(p,r)=>m.set(p,r.clone())};};
+ const network=async request=>{const path=new URL(request.url).pathname;calls.push(path);if(fail.includes(path))throw new Error('offline');const r=new Response(path==='/trip'?(login?'<html>Sign in</html>':'<html><h1 id="trip-title">Diary</h1></html>'):'export const cached=true;',{headers:{'content-type':path==='/trip'?'text/html':'text/javascript'}});if(path==='/trip')Object.defineProperty(r,'redirected',{value:true});return r;};
