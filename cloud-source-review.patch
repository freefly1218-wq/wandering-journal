+.cf-row.d { grid-template-columns: minmax(0, 1fr) minmax(0, 150px); }
+.cf-row.d input { grid-column: 1 / -1; grid-row: 2; }
+.cf-row.g { grid-template-columns: auto minmax(0, 1fr) 38px; }
