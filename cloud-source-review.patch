+    const doc = document.createElement("div");
+    doc.id = "pdfdoc";
+    try {
+      pdfMsg("正在載入 PDF 工具…");
+      for (const src of PDF_LIBS) await loadJs(src);
+      doc.innerHTML = pdfHtml(full);
+      document.body.appendChild(doc);
+      await Promise.all([...doc.querySelectorAll("img")].map((im) => (im.complete ? null : new Promise((ok) => { im.onload = im.onerror = ok; }))));
+      try { await document.fonts.ready; } catch (e) {}
+      const pdf = new window.jspdf.jsPDF({ unit: "pt", format: "a4" });
+      const PW = 595.28, PH = 841.89, M = 30, W = doc.offsetWidth, k = (PW - 2 * M) / W, H = (PH - 2 * M) / k;
+      const secs = [...doc.querySelectorAll(".pd-sec")];
+      let first = true;
+      for (let i = 0; i < secs.length; i++) {
+        pdfMsg("正在產生 PDF… " + (i + 1) + "／" + secs.length);
+        const sec = secs[i], top = sec.getBoundingClientRect().top, sh = sec.offsetHeight;
+        // Stay under the ~16M-pixel canvas ceiling of phones.
+        const scale = Math.min(2, Math.sqrt(16e6 / (W * sh)));
+        const canvas = await window.html2canvas(sec, { scale, backgroundColor: "#ffffff", useCORS: true, logging: false });
+        const blocks = [...sec.querySelectorAll(".pd-blk")].map((b) => { const r = b.getBoundingClientRect(); return [r.top - top, r.bottom - top]; });
+        let y = 0;
+        while (y < sh - 1) {
+          let cut = Math.min(sh, y + H);
+          if (cut < sh) blocks.forEach(([t, b]) => { if (t > y + 1 && t < cut && b > cut) cut = Math.min(cut, t); });
